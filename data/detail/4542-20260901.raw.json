{"glossary": {"short": "科嶠", "full": "科嶠", "brand": "", "names": [], "terms": ["Safe Harbor Statement", "EPS", "YoY", "QoQ"]}, "segments": [{"start": 0.0, "end": 4.34, "text": "不限公司 吳明智 董事長上台致詞 掌聲歡迎"}, {"start": 4.34, "end": 12.52, "text": "貴滿 宗鑫 陳總 賈登 邱董"}, {"start": 12.52, "end": 14.68, "text": "還有我們德馨的兄弟"}, {"start": 14.68, "end": 16.8, "text": "還有各位投資大眾"}, {"start": 16.8, "end": 18.56, "text": "大家午安 大家好"}, {"start": 18.56, "end": 19.68, "text": "好"}, {"start": 19.68, "end": 22.0, "text": "那近年來我們台灣"}, {"start": 22.0, "end": 24.0, "text": "一件事情就繞動"}, {"start": 24.0, "end": 26.6, "text": "我們整個台灣就是AI"}, {"start": 26.6, "end": 28.88, "text": "那AI對我們公司就"}, {"start": 28.88, "end": 30.68, "text": "兩個成長引擎"}, {"start": 30.68, "end": 33.2, "text": "第一個成長引擎是來自於"}, {"start": 33.2, "end": 35.2, "text": "市府基板的需求"}, {"start": 35.2, "end": 37.2, "text": "已經讓我們公司在"}, {"start": 37.2, "end": 39.2, "text": "原來的甘志成領域"}, {"start": 39.2, "end": 41.2, "text": "接單就是接到比較"}, {"start": 41.2, "end": 43.2, "text": "還蠻順利的"}, {"start": 43.2, "end": 45.2, "text": "那第二個就是"}, {"start": 45.2, "end": 47.2, "text": "半導體晶片的需求"}, {"start": 47.2, "end": 49.2, "text": "那半導體晶片"}, {"start": 49.2, "end": 51.2, "text": "必須放在FOOP裡面"}, {"start": 51.2, "end": 53.2, "text": "那FOOP是由"}, {"start": 53.2, "end": 55.2, "text": "我們全台灣最厲害的嘉賓在提供"}, {"start": 55.2, "end": 57.2, "text": "然後我來幫他做清洗"}, {"start": 57.2, "end": 59.2, "text": "好"}, {"start": 59.2, "end": 61.2, "text": "那一個AI"}, {"start": 101.38, "end": 104.78, "text": "和布魯克斯策略聯盟"}, {"start": 104.78, "end": 107.48, "text": "其餘關於財務公開資訊"}, {"start": 107.48, "end": 108.78, "text": "都已經有相關資料"}, {"start": 108.78, "end": 109.88, "text": "所以這個部分"}, {"start": 109.88, "end": 111.48, "text": "我就快速帶過"}, {"start": 111.48, "end": 113.08, "text": "時間我們留給後面"}, {"start": 115.08, "end": 117.88, "text": "接下來我們先看第二季的財務表現"}, {"start": 117.88, "end": 120.98, "text": "第二季營業收入3億3773萬"}, {"start": 120.98, "end": 123.38, "text": "季增55% 年增51%"}, {"start": 123.38, "end": 126.18, "text": "這個是近六季的單季新高"}, {"start": 126.18, "end": 128.58, "text": "毛利率來到了39%"}, {"start": 128.58, "end": 129.68, "text": "與第一季持平"}, {"start": 129.68, "end": 132.48, "text": "較去年同期我們增加了4個百分點"}, {"start": 132.48, "end": 134.88, "text": "每股盈餘1.07億元"}, {"start": 134.88, "end": 138.32, "text": "較第一季的0.40元也有明顯的跳升"}, {"start": 138.32, "end": 144.48, "text": "整體來說 第二季是我們營收跟獲利都有同步放大的一季"}, {"start": 144.48, "end": 147.92, "text": "接下來我們看資產負債表的部分"}, {"start": 147.92, "end": 149.36, "text": "其中三個重點"}, {"start": 149.36, "end": 152.72, "text": "現金跟約當現金是4億4300萬元"}, {"start": 152.72, "end": 155.12, "text": "水位5000 負債比53%"}, {"start": 155.12, "end": 158.48, "text": "較去年的58%下降了5個百分點"}, {"start": 158.48, "end": 161.44, "text": "存貨中轉天數331天"}, {"start": 161.44, "end": 164.04, "text": "較第一季大幅縮短了93天"}, {"start": 164.04, "end": 166.8, "text": "營業中轉天數也縮短了68天"}, {"start": 166.8, "end": 170.96, "text": "第一季我們對高存貨在第二季已經順利轉為出貨"}, {"start": 170.96, "end": 173.44, "text": "接下來在上半年的營業活動"}, {"start": 173.44, "end": 175.52, "text": "進現金收入3700萬元"}, {"start": 175.52, "end": 179.28, "text": "自由現金流由去年的同季轉升為900萬元"}, {"start": 179.28, "end": 182.88, "text": "獲利品質跟現金的創造能力都在改善中"}, {"start": 182.88, "end": 186.16, "text": "接下來我們看營運面的部分"}, {"start": 186.16, "end": 192.56, "text": "這個照圖是近六季的營收 毛利 以及毛利率的走勢"}, {"start": 192.56, "end": 194.56, "text": "其中我們兩個觀察點"}, {"start": 194.56, "end": 198.88, "text": "第一個 營收從2026年第一季一路走高"}, {"start": 198.88, "end": 203.36, "text": "到第二季的3.38億是近六季的高點"}, {"start": 203.36, "end": 208.8, "text": "第二個點 毛利率從2025年初的33%水準"}, {"start": 208.8, "end": 212.0, "text": "逐季爬升到目前的39%左右"}, {"start": 212.0, "end": 216.0, "text": "營收放大同時 毛利的結構也同時在改"}, {"start": 216.0, "end": 217.2, "text": "同步再改善"}, {"start": 217.2, "end": 220.7, "text": "這是我們對上半年感到滿意的地方"}, {"start": 222.51, "end": 225.41, "text": "接下來我們看我們營收地區的結構"}, {"start": 225.41, "end": 228.61, "text": "這是今年上半年比較大的一個變化"}, {"start": 228.91, "end": 231.31, "text": "整個上半年的營業累積營收"}, {"start": 231.31, "end": 234.11, "text": "裡面東南亞的地區佔了30%"}, {"start": 234.11, "end": 236.01, "text": "去年同期只有18%"}, {"start": 236.01, "end": 239.41, "text": "整體營收近1.7億 年增120%"}, {"start": 240.11, "end": 241.41, "text": "展望明年"}, {"start": 241.41, "end": 243.11, "text": "今年下半年以及明年"}, {"start": 243.11, "end": 244.21, "text": "在產品線"}, {"start": 244.21, "end": 245.61, "text": "我們在台灣的部分"}, {"start": 245.61, "end": 249.01, "text": "將會專注於半導體清洗設備的業務發展"}, {"start": 249.01, "end": 253.41, "text": "在我們中國河源的生產基地將會提升產能效率"}, {"start": 253.41, "end": 257.81, "text": "以因應強大的PCP以及載板的成長需求"}, {"start": 259.21, "end": 261.41, "text": "接下來我們進入第三部分"}, {"start": 263.21, "end": 266.21, "text": "首先我們先講我們河源的生產基地"}, {"start": 266.21, "end": 269.21, "text": "這張圖是我們河源產值的對比"}, {"start": 269.21, "end": 272.01, "text": "對比的基準是2025年的1到7月"}, {"start": 272.01, "end": 274.61, "text": "作為100%的部分"}, {"start": 274.61, "end": 276.21, "text": "2026年的同期"}, {"start": 276.21, "end": 278.81, "text": "我們已經成長到194%"}, {"start": 278.81, "end": 280.01, "text": "成長94%"}, {"start": 280.01, "end": 282.81, "text": "將近翻倍的產能擴增"}, {"start": 282.81, "end": 284.81, "text": "成長的背後是我們東南亞"}, {"start": 284.81, "end": 287.21, "text": "增中國的市場的需求詳盡"}, {"start": 287.21, "end": 288.61, "text": "這就是呼應到剛剛講的"}, {"start": 288.61, "end": 292.49, "text": "AI伺服器基板的這個部分"}, {"start": 292.49, "end": 294.49, "text": "接下來我們再回到我們"}, {"start": 294.49, "end": 297.09, "text": "台灣的半導體佈局的部分"}, {"start": 297.09, "end": 298.69, "text": "我們用研發的歷程"}, {"start": 298.69, "end": 301.09, "text": "帶大家快速的看一遍"}, {"start": 301.09, "end": 303.49, "text": "這個重點不在於我們單一的機型"}, {"start": 303.49, "end": 307.89, "text": "強調整體研發發展的節奏"}, {"start": 307.89, "end": 313.49, "text": "2020年7月是NFC-H12 半導體載具清洗機"}, {"start": 313.49, "end": 317.89, "text": "這是科教切入半導體清洗的起點"}, {"start": 317.89, "end": 321.89, "text": "2021年4月Panel復盆全自動清洗機"}, {"start": 321.89, "end": 326.89, "text": "對應到Cowass載板製成的大尺寸復盆"}, {"start": 326.89, "end": 331.29, "text": "2022年9月研發生產超純的加熱器"}, {"start": 331.29, "end": 335.89, "text": "突破家樂設備被國外大廠捆綁的市場障礙"}, {"start": 335.89, "end": 338.69, "text": "累積銷售已經達到20台以上"}, {"start": 338.69, "end": 340.99, "text": "在2024年12月"}, {"start": 340.99, "end": 345.89, "text": "NFC R300是Foop全自動清潔機 UPH30"}, {"start": 345.89, "end": 348.49, "text": "同時集結了多項專利設計"}, {"start": 348.49, "end": 350.69, "text": "這是目前主力的機型"}, {"start": 350.69, "end": 353.19, "text": "在2025年4月"}, {"start": 353.19, "end": 355.79, "text": "大尺寸的半自動清潔機"}, {"start": 355.79, "end": 359.69, "text": "全部全客製化對應多樣載具需求"}, {"start": 359.69, "end": 365.19, "text": "2025年10月 載具器密檢測設備"}, {"start": 365.19, "end": 369.89, "text": "從清洗領域延伸到檢測部分"}, {"start": 370.89, "end": 372.69, "text": "最後在今年2月"}, {"start": 372.69, "end": 377.49, "text": "NFC R310對應到310mini FUG新規格"}, {"start": 377.49, "end": 380.49, "text": "而且這個設備同時兼容多家FUG"}, {"start": 380.49, "end": 382.49, "text": "總共6年的時間"}, {"start": 382.49, "end": 384.69, "text": "總共剛剛講的7項產品"}, {"start": 384.69, "end": 387.29, "text": "平均每一年推出一台新的機器"}, {"start": 387.29, "end": 389.29, "text": "從清洗到加熱"}, {"start": 389.29, "end": 391.69, "text": "以及到檢測行程完整的方案"}, {"start": 391.69, "end": 393.99, "text": "這是我們科教的核心能力"}, {"start": 393.99, "end": 395.29, "text": "快速的研發"}, {"start": 395.29, "end": 396.59, "text": "快速的展出"}, {"start": 396.59, "end": 398.29, "text": "而這個能力就是接下來"}, {"start": 398.29, "end": 401.49, "text": "我們會跟布魯克斯合作的一個基礎"}, {"start": 402.79, "end": 404.09, "text": "第四個部分"}, {"start": 404.09, "end": 405.49, "text": "我們講近期衝突事件"}, {"start": 405.49, "end": 407.29, "text": "今年最重要的一件事情"}, {"start": 407.29, "end": 408.89, "text": "在6月30日"}, {"start": 408.89, "end": 411.59, "text": "我們科教與美國半導體設備大廠布魯克斯"}, {"start": 411.59, "end": 412.79, "text": "簽署了副本"}, {"start": 412.79, "end": 415.99, "text": "晶圓載具清洗設備的技術授權協議"}, {"start": 415.99, "end": 420.99, "text": "我們共同成立半導體技術在地化創新策略聯盟"}, {"start": 420.99, "end": 424.75, "text": "這個合作的背景是我們全球供應鏈的雄主"}, {"start": 424.75, "end": 429.15, "text": "客戶越來越重視供應鏈的安全及及時消負"}, {"start": 429.15, "end": 433.75, "text": "需要在地創新加上全球服務的完整方案"}, {"start": 433.75, "end": 437.35, "text": "我們雙方也建立了兩大共同主軸"}, {"start": 437.35, "end": 445.15, "text": "供應鏈在地化以及節水節電減碳的 ESG 永續清洗技術"}, {"start": 445.15, "end": 449.95, "text": "我們的合作是把兩家公司的最強的部分都結合在一起"}, {"start": 449.95, "end": 452.05, "text": "科教的強項是創新引擎"}, {"start": 452.05, "end": 454.45, "text": "BluX的強項是全球平台"}, {"start": 454.45, "end": 455.85, "text": "對科教來說"}, {"start": 455.85, "end": 460.05, "text": "以我們台灣中小企業的單獨之力"}, {"start": 460.05, "end": 463.25, "text": "我們要建立全球半導體客戶的業務網絡"}, {"start": 463.25, "end": 465.75, "text": "其實是一段蠻漫長的路"}, {"start": 465.75, "end": 467.65, "text": "藉由BluX的全球支援"}, {"start": 467.65, "end": 469.65, "text": "這段路我們可以大幅縮短"}, {"start": 469.65, "end": 471.15, "text": "對BluX來說"}, {"start": 471.15, "end": 474.95, "text": "取得一個有技術實力的台灣在地夥伴"}, {"start": 474.95, "end": 478.15, "text": "強化在地供應的即時交付能力"}, {"start": 478.15, "end": 482.55, "text": "然後合作讓我們雙方一起走得更快 更遠"}, {"start": 484.15, "end": 487.95, "text": "最後我們把這個合作定位為三營的一個狀態"}, {"start": 488.45, "end": 492.35, "text": "客戶這邊可以得到供應鏈安全以及即時交付的保障"}, {"start": 492.35, "end": 494.75, "text": "同時擁有台灣的創新速度"}, {"start": 494.75, "end": 498.55, "text": "創新速度以及國際際的微運服務"}, {"start": 498.55, "end": 500.35, "text": "以及更永續的信息方案"}, {"start": 500.75, "end": 503.95, "text": "Brooks這邊導入敏捷的創新研發能量"}, {"start": 503.95, "end": 508.35, "text": "取得可信賴的供應鏈夥伴 豐富全球的產品組合"}, {"start": 508.35, "end": 512.45, "text": "科教藉由全球資源快速拓展全球市場"}, {"start": 512.45, "end": 515.45, "text": "技術價值轉化為長期收益"}, {"start": 515.45, "end": 519.35, "text": "自主技術獲得國際肯定 加速半導體佈局"}, {"start": 519.35, "end": 522.95, "text": "為客戶創造最大價值的同時"}, {"start": 522.95, "end": 526.15, "text": "合作的每一方都獲得應得的成長"}, {"start": 526.15, "end": 528.75, "text": "這是我們對聯盟的定義"}, {"start": 528.75, "end": 531.15, "text": "最後我總結一下今天的重點"}, {"start": 531.15, "end": 537.25, "text": "前兩季第二季的營收獲利同步創高 毛利率佔39%"}, {"start": 537.25, "end": 542.95, "text": "東南亞越成為第二大的市場 荷園生產基地產能接近翻倍"}, {"start": 542.95, "end": 546.75, "text": "半導體方案六年七項產品累積出來的研發能量"}, {"start": 546.75, "end": 550.05, "text": "帶來與Bluix策略聯盟長期合作"}, {"start": 550.05, "end": 556.05, "text": "科教正從PCP設備廠穩步走向半導體設備的國際舞台"}, {"start": 556.05, "end": 560.05, "text": "以上是我科教工業的簡報 謝謝大家"}, {"start": 561.15, "end": 564.91, "text": "接下來有請維田科技股份有限公司"}, {"start": 564.91, "end": 567.91, "text": "李傳的同事上台致詞掌聲歡迎"}, {"start": 567.91, "end": 573.97, "text": "貴賣陳總經理"}, {"start": 573.97, "end": 575.97, "text": "還有我們德興的夥伴"}, {"start": 575.97, "end": 578.97, "text": "跟各位投資先進"}, {"start": 578.97, "end": 580.97, "text": "大家午安 大家好"}]}