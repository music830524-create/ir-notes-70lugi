{"glossary": {"short": "方土昶", "full": "堃昶股份有限公司", "brand": "Uppertech", "names": [], "terms": ["Uppertech", "TWO", "Q1-Q3", "YoY", "SG", "EPS", "DRAM", "Tier-1", "EMS", "BU", "AI", "DDR4", "DDR5", "LPDDR5", "ASP", "IPC", "AIoT", "SenTao", "TCM", "MOHW", "COSMED", "GMP", "AIOT", "Safe Harbor Statement", "QoQ"]}, "segments": [{"start": 1.04, "end": 5.64, "text": "堃昶股份有限公司 2026 年度法人說明會。"}, {"start": 5.64, "end": 10.65, "text": "免責申領請參業等簡報。"}, {"start": 10.65, "end": 13.25, "text": "簡報大綱 1. 2026 年"}, {"start": 13.25, "end": 15.85, "text": "3. 第一前三季財務績小"}, {"start": 15.85, "end": 20.65, "text": "2. 半導體事業部業務現況與產業趨勢"}, {"start": 20.65, "end": 25.05, "text": "3. 半導體事業部客戶佈局與未來發展策略"}, {"start": 25.05, "end": 29.85, "text": "4. 生技事業部人工藥業先淘汰半年品牌轉型擴展"}, {"start": 29.85, "end": 32.05, "text": "5. 終結於 Q&A"}, {"start": 32.05, "end": 40.87, "text": "前三季營收突破 40.366 億元"}, {"start": 40.87, "end": 44.37, "text": "營業毛利 13.8207 萬元"}, {"start": 44.37, "end": 47.07, "text": "毛利率 34.24%"}, {"start": 47.07, "end": 51.15, "text": "營業低益 12.8362 萬元"}, {"start": 51.15, "end": 55.25, "text": "本期稅後淨利 11.5518 萬元"}, {"start": 55.25, "end": 58.69, "text": "美股盈餘 EPS 9.78 元"}, {"start": 58.69, "end": 61.89, "text": "前三季營收突破 40.366 億元"}, {"start": 61.89, "end": 69.21, "text": "年增率656% 毛利率17.16% 提升到34.24%"}, {"start": 69.21, "end": 74.69, "text": "營業利益12.84億元 營業利益31.8%"}, {"start": 74.69, "end": 81.09, "text": "本年截至第三季 稅後淨利11.55億元 每股營運9.78元"}, {"start": 81.09, "end": 85.59, "text": "資產負債結構 截至2026年9月30"}, {"start": 85.59, "end": 90.33, "text": "現金及月當現金10億7965萬元"}, {"start": 90.33, "end": 94.81, "text": "流動資產額計 34億 6,673萬元"}, {"start": 94.81, "end": 99.81, "text": "資產總計 36億 8,838萬元"}, {"start": 99.81, "end": 103.61, "text": "負債總計 10億 8,819萬元"}, {"start": 103.61, "end": 106.65, "text": "群益總計 26億元"}, {"start": 106.65, "end": 108.77, "text": "帳倉約到現金10.8億元"}, {"start": 108.77, "end": 111.65, "text": "佔總資產比重約 32%"}, {"start": 111.65, "end": 114.09, "text": "流動資產佔 94%"}, {"start": 114.09, "end": 117.69, "text": "負債比率約 29.5%"}, {"start": 117.69, "end": 122.67, "text": "股東權益總計 26億元"}, {"start": 122.67, "end": 125.19, "text": "接下來是報告半導體事業部"}, {"start": 125.19, "end": 128.55, "text": "業務現況與客戶的佈局"}, {"start": 128.55, "end": 130.87, "text": "公司成立1998年開始"}, {"start": 130.87, "end": 136.83, "text": "深恩電子令儲建與半導體的代銷近30年"}, {"start": 136.83, "end": 140.35, "text": "位於台灣電子供應鏈核心的樞紐"}, {"start": 140.35, "end": 142.67, "text": "掌握即時的市場需求資訊"}, {"start": 142.67, "end": 145.11, "text": "提供原廠與下游製造商之間"}, {"start": 145.11, "end": 149.27, "text": "高效率的供應鏈管理與庫存的條件服務"}, {"start": 149.27, "end": 151.31, "text": "公司主要代理低潤記憶體"}, {"start": 151.31, "end": 155.91, "text": "包括模具化 解決方案 滿足客戶訂單的需求"}, {"start": 155.91, "end": 157.95, "text": "國內外一線核心的客戶群"}, {"start": 157.95, "end": 162.39, "text": "合作客戶涵蓋全球知名系統整合商與電子大廠"}, {"start": 162.39, "end": 168.47, "text": "第二 記憶體產業的趨勢分析"}, {"start": 168.47, "end": 174.15, "text": "屬於目前AI人工智慧伺服器與邊緣AI裝置技術普及"}, {"start": 174.15, "end": 177.55, "text": "帶動單機記憶體搭載容量大幅倍增"}, {"start": 177.55, "end": 181.95, "text": "觀察起後 AI伺服器與邊緣設計設備廠"}, {"start": 181.95, "end": 187.25, "text": "商品及快速回應客戶大容量記憶體採購需求"}, {"start": 187.25, "end": 189.45, "text": "次世代規格升級潮"}, {"start": 189.45, "end": 193.69, "text": "記憶體市場加速有 DDR4 世代像 DDR5"}, {"start": 193.69, "end": 197.89, "text": "Low Power DDR5 總款新規格顯著提升"}, {"start": 197.89, "end": 200.45, "text": "高階車用電子與工業電腦"}, {"start": 200.45, "end": 206.19, "text": "嚴格要求長時間穩定 供貨與高耐用性規格"}, {"start": 206.19, "end": 208.69, "text": "未來發展與產品的策略"}, {"start": 208.69, "end": 212.29, "text": "擴展高附加價值代理產品線"}, {"start": 212.29, "end": 214.33, "text": "積極爭取高效能記憶體"}, {"start": 214.33, "end": 218.09, "text": "車用晶片與AIoT模組等高毛利代理線"}, {"start": 218.09, "end": 221.77, "text": "深化產品多元性與技術服務水準"}, {"start": 221.77, "end": 224.21, "text": "精準庫存與周轉率的管理"}, {"start": 224.21, "end": 226.81, "text": "運用庫存追蹤與供應鏈系統"}, {"start": 226.81, "end": 228.77, "text": "精準預測庫存需求"}, {"start": 228.77, "end": 230.41, "text": "提高資金周轉率"}, {"start": 230.41, "end": 232.73, "text": "並降低市場的波動風險"}, {"start": 232.73, "end": 235.09, "text": "深化與大廠夥伴關係"}, {"start": 235.09, "end": 238.05, "text": "持續鞏固與關鍵客戶長期合作"}, {"start": 238.05, "end": 242.13, "text": "共同開發高成長吸引用領域"}, {"start": 242.13, "end": 243.51, "text": "在生技事業部"}, {"start": 243.51, "end": 246.45, "text": "人說藥業仙桃牌的品牌轉型上"}, {"start": 246.45, "end": 248.45, "text": "百年品牌傳承"}, {"start": 248.45, "end": 250.97, "text": "仙桃牌始創於 1889 年"}, {"start": 250.97, "end": 254.85, "text": "為台灣享譽盛名的百年漢方調理品牌"}, {"start": 254.85, "end": 256.57, "text": "昆藏持股"}, {"start": 256.57, "end": 258.17, "text": "百分之百人說藥業"}, {"start": 258.17, "end": 260.81, "text": "積極的挹注現代化管理與資源"}, {"start": 260.81, "end": 264.65, "text": "推動中藥 漢方調等生物科技的轉型"}, {"start": 264.65, "end": 267.01, "text": "三大經典中成藥品與飲品"}, {"start": 267.01, "end": 270.93, "text": "有保水瓶丸 通乳丸 體健丸"}, {"start": 270.93, "end": 274.77, "text": "還有現代漢方調理集液系列"}, {"start": 274.77, "end": 278.45, "text": "鎖定全家庭的調養需求"}, {"start": 278.45, "end": 285.86, "text": "本身繼事業部的實體公佈與市場的擴展上"}, {"start": 285.86, "end": 289.18, "text": "2025年進入全台去城市實體門市"}, {"start": 289.18, "end": 291.62, "text": "有效擴大各族群的接觸面"}, {"start": 291.62, "end": 294.7, "text": "提升品牌時尚與年輕化的形象"}, {"start": 294.7, "end": 297.98, "text": "2026年上架大型藥妝"}, {"start": 297.98, "end": 300.06, "text": "安氏美全台實體門市"}, {"start": 300.06, "end": 303.1, "text": "聚焦日常漢方專屬調理產品"}, {"start": 303.1, "end": 306.1, "text": "提升產品的市場滲透度"}, {"start": 306.1, "end": 307.38, "text": "2026年"}, {"start": 307.38, "end": 310.69, "text": "台灣最大專業連鎖藥局"}, {"start": 310.69, "end": 312.41, "text": "大樹藥局建立合作"}, {"start": 312.41, "end": 313.69, "text": "專業醫藥通路"}, {"start": 313.69, "end": 319.1, "text": "建立消費者對漢方藥品的專業信任"}, {"start": 319.1, "end": 321.02, "text": "營運轉型與中產期的展望"}, {"start": 321.02, "end": 322.7, "text": "在半導體的部分"}, {"start": 322.7, "end": 326.54, "text": "公司為文化營收與充沛的營運現金流"}, {"start": 326.54, "end": 330.22, "text": "為轉型投資提供穩定 穩固支撐"}, {"start": 330.22, "end": 332.06, "text": "掌握DRAM上升的趨勢"}, {"start": 332.06, "end": 334.94, "text": "受惠 AI 邊緣運算與 DRAM 價格"}, {"start": 334.94, "end": 338.2, "text": "A 回升潮 獲利能力協助拉伸"}, {"start": 338.2, "end": 339.94, "text": "持續擴展新代理線"}, {"start": 339.94, "end": 344.74, "text": "優化高物價值 高價值價值產品組合"}, {"start": 344.74, "end": 347.22, "text": "鞏固客戶合作人的著度"}, {"start": 347.22, "end": 350.08, "text": "在實際 先淘汰的部分"}, {"start": 350.08, "end": 351.94, "text": "中藥汗方產品"}, {"start": 351.94, "end": 355.98, "text": "中藥品條理已符合現代人注重調養特性"}, {"start": 355.98, "end": 358.3, "text": "逐步拉伸成長"}, {"start": 358.3, "end": 359.94, "text": "全東路的實體佈局"}, {"start": 359.94, "end": 364.44, "text": "打通區城市康氏美大塑料局等大型連鎖通路"}, {"start": 364.44, "end": 366.6, "text": "擴展廣大消費群"}, {"start": 366.6, "end": 368.64, "text": "百年品牌新風貿"}, {"start": 368.64, "end": 371.28, "text": "結合現代GMP製藥技術"}, {"start": 371.28, "end": 373.14, "text": "與時尚的包裝 推動"}, {"start": 373.14, "end": 375.16, "text": "先淘汰永續成長"}, {"start": 375.16, "end": 380.03, "text": "好 那接下來是Q&A的部分"}, {"start": 380.03, "end": 381.53, "text": "感謝各位脖子先進"}, {"start": 381.53, "end": 385.03, "text": "如果有問題的話 歡迎提問"}, {"start": 385.03, "end": 396.97, "text": "沒有提問的話 沒有問題的話"}, {"start": 396.97, "end": 399.61, "text": "那我們今天訪收會就到這裡結束"}, {"start": 399.61, "end": 401.41, "text": "謝謝 謝謝各位"}, {"start": 401.41, "end": 403.41, "text": "感謝立民指導 謝謝"}]}